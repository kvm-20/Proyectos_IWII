# ============================================================
# Copie este archivo como .env y cambie las claves.
# El archivo .env NUNCA se sube a GitHub (esta en .gitignore).
# ============================================================

# --- Backend ---
SECRET_KEY=cambie-esta-clave-secreta-larga
JWT_SECRET_KEY=cambie-esta-clave-jwt-de-al-menos-32-caracteres
ADMIN_EMAIL=admin@biblioweb.com
ADMIN_PASSWORD=Admin123*

# --- MySQL (Docker Compose / Kubernetes) ---
MYSQL_DATABASE=biblioweb
MYSQL_USER=biblioweb
MYSQL_PASSWORD=cambie-esta-clave-mysql
MYSQL_ROOT_PASSWORD=cambie-esta-clave-root

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=cambie-esta-clave-grafana

# Para desarrollo local SIN Docker se usa SQLite automaticamente.
# Si quiere usar el MySQL del docker-compose desde su equipo, descomente:
# DATABASE_URL=mysql+pymysql://biblioweb:cambie-esta-clave-mysql@127.0.0.1:3307/biblioweb
